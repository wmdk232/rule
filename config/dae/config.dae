# 订阅用V2ray/URL格式，不支持mihomo格式。
subscription {
    sub: 'http://192.168.2.3:3001/a7f3c9e2b1d84f60/download/collection/singbox'
}

# node {
#     my_vps: 'hysteria2://密码@vps.example.com:443/?sni=vps.example.com'
#     relay: 'vless://UUID@us.example.com:443?security=tls&sni=us.example.com -> trojan://密码@hk.example.com:443?sni=hk.example.com' # 链式代理：落地 -> 前置
# }

# 组名只能用英文；policy 可选 min_moving_avg（移动平均延迟最低）/ min_avg10（近 10 次平均延迟最低）/ min（最近一次延迟最低）/ random（随机）/ fixed(n)（固定组内第 n 个，从 0 数）
group {
    Proxy {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        policy: min_moving_avg
    }
    AI {
        filter: name(regex: '🇺🇸|US|美国|美|United States|新加坡') && !name(regex: '排除')
        policy: min_moving_avg
    }
    jp {
        filter: name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '排除')
        policy: min_moving_avg
    }
}
dns {
    upstream {
        remote: 'https://8.8.8.8/dns-query'
        local: 'https://223.5.5.5/dns-query'
    }
    routing {
        request {
            qtype(https, svcb) -> reject
            qtype(aaaa) -> reject
            qname(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> remote
            qname(geosite: cn, geosite: microsoft@cn, geosite: apple@cn, geosite: private) -> local
            qname(geosite: geolocation-!cn) -> remote
            fallback: remote
        }
        response {
            # remote 解析出国内 IP 时改用 local 重查，拿到就近 CDN
            upstream(remote) && ip(geoip: cn) -> local
            fallback: accept
        }
    }
}

routing {
    dip(224.0.0.0/3, 'ff00::/8') -> direct
    dport(853) -> block
    dip(geoip: private, geoip: cn) -> direct
    l4proto(udp) && dport(443) -> block

    # 核心 DMM 域名（含 CDN 和 API），全部走日本节点
    domain(suffix: dmm.co.jp) -> jp
    domain(suffix: dmm.com) -> jp
    domain(suffix: dmmapis.com) -> jp
    domain(suffix: digitaldmm.co.jp) -> jp
    domain(suffix: dmm-extension.com) -> jp
    # 其他有地区限制的日本站点
    domain(suffix: mgstage.com) -> jp
    domain(suffix: fc2.com) -> jp
    domain(suffix: caribbeancom.com) -> jp
    domain(suffix: hbox.jp) -> jp
    domain(suffix: avmoo.website) -> jp
    domain(suffix: avsox.click) -> jp
    # 资料/索引站（无严格地区限制，可走普通代理或直连）
    domain(suffix: javbus.com) -> Proxy
    domain(suffix: jav321.com) -> Proxy
    domain(suffix: javten.com) -> Proxy
    domain(suffix: theporndb.net) -> Proxy
    domain(suffix: xchina.co) -> Proxy
    domain(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> Proxy
    domain(suffix: withgoogle.com, suffix: notebooklm.google, geosite: category-ai-!cn) -> jp
    domain(geosite: youtube) -> Proxy
    domain(geosite: google) -> Proxy
    domain(geosite: github) -> Proxy
    domain(geosite: onedrive) -> Proxy
    domain(geosite: microsoft@cn) -> direct
    domain(geosite: microsoft) -> direct
    domain(geosite: apple@cn) -> direct
    domain(geosite: apple) -> direct
    domain(geosite: telegram) -> Proxy
    domain(geosite: tiktok) -> Proxy
    domain(geosite: netflix) -> Proxy
    domain(geosite: paypal, geosite: binance, geosite: okx, geosite: category-cryptocurrency) -> Proxy
    domain(geosite: steam@cn) -> direct
    domain(geosite: steam) -> Proxy
    domain(geosite: geolocation-!cn) -> Proxy
    fallback: Proxy
}

global {
    lan_interface: br-lan1 # 改成自己的局域网网卡，ip a 查看
    wan_interface: auto
    auto_config_kernel_parameter: true
    so_mark_from_dae: 0
    dial_mode: domain
    tls_implementation: utls
    bootstrap_resolver: '119.29.29.29:53'
    log_level: info
    check_interval: 30s
    check_tolerance: 50ms
}

api {
    enabled: true
    listen: '127.0.0.1:9527'

    # 请替换成自己生成的随机 Token
    secret: '5b667a013daa227f9b17bc4fe1da37b3c9f05c2b35b7872e9ed7659d486fa893'

    # Doona 前端静态文件目录
    ui: '/usr/share/doona-web'
}
